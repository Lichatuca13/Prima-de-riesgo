# Copia este archivo como .env y pon tus claves detrás del =
# Son las mismas de las sesiones 5 y 6: si ya tienes aquel .env, cópialo aquí.
# Esto es para tu ordenador. En Vercel, la clave va en Settings > Environment Variables del proyecto.

# El LLM que explica la prima con palabras. Con esta basta.
GROQ_API_KEY=

# Opcional: si Groq no contesta, el párrafo sale de Gemini.
GEMINI_API_KEY=

# Con las dos claves se empieza por Groq. Para empezar por Gemini:
# LLM_PROVEEDOR=gemini
